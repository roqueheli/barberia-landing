{
  "name": "better-barber-club",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Dominio propio en vez del *.workers.dev por defecto. Requiere que
  // betterbarberclub.cl y www.betterbarberclub.cl ya estén agregados como
  // dominios en esta cuenta de Cloudflare (DNS gestionado por Cloudflare)
  // antes del próximo `wrangler deploy` — si no, el deploy falla al
  // intentar atar la ruta a un dominio que Cloudflare no reconoce.
  "routes": [
    { "pattern": "betterbarberclub.cl", "custom_domain": true },
    { "pattern": "www.betterbarberclub.cl", "custom_domain": true }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "better-barber-club"
    }
  ],
  // Cache incremental (ver open-next.config.ts) — falta crear el bucket antes
  // del próximo deploy:
  //   wrangler login   (si no está autenticado)
  //   wrangler r2 bucket create better-barber-club-cache
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "better-barber-club-cache"
    }
  ],
  // Cola de revalidación en background (Durable Object) que exige el queue
  // "doQueue" de open-next.config.ts — sin binding, la revalidación por
  // tiempo (`next:{revalidate}`, usada en todo el sitio) no funciona en
  // producción. La clase "DOQueueHandler" la genera el build de OpenNext
  // (.open-next/worker.js), no hay que escribirla a mano.
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }
  ],
  // Variables de RUNTIME del Worker. Wrangler/OpenNext toman estos `vars` como
  // fuente de verdad al desplegar; las variables cargadas solo en el panel de
  // build NO se propagan al runtime del Worker (por eso process.env.KLIPPER_*
  // salía undefined y los endpoints devolvían 503 not_configured).
  //
  // NINGÚN secreto va acá: base URL y slug son endpoints públicos de Klipper y
  // las NEXT_PUBLIC_* son públicas por definición. GOOGLE_PLACES_API_KEY se
  // maneja aparte como Secret en el panel de Cloudflare (nunca versionada).
  "vars": {
    "KLIPPER_API_BASE_URL": "https://klipperapp-be-6fbfe24ddcb3.herokuapp.com/",
    "KLIPPER_ORG_SLUG": "better-barber-club",
    "KLIPPER_API_TIMEOUT_MS": "3000",
    "NEXT_PUBLIC_SITE_NAME": "Better Barber Club",
    "NEXT_PUBLIC_SITE_SHORT_NAME": "Better Barber Club",
    "NEXT_PUBLIC_APPOINTMENTS_ENABLED": "true",
    "NEXT_PUBLIC_SANITY_PROJECT_ID": "s3l1tw2t",
    "NEXT_PUBLIC_SANITY_DATASET": "production",
    "NEXT_PUBLIC_SANITY_API_VERSION": "2026-08-30"
  }
}
